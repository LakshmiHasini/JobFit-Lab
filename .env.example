# Development runs locally without MongoDB; private data persists in .data/.
DEMO_MODE=true
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Required with DEMO_MODE=false. Use a long random value for SESSION_SECRET.
MONGODB_URI=mongodb://127.0.0.1:27017/jobfit-lab
SESSION_SECRET=
# Optional server-side GitHub API token for higher public-data rate limits.
# Never place this in VITE_ variables or commit an actual token.
GITHUB_TOKEN=
